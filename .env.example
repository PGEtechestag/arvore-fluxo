# ===============================
# DataJud (CNJ) - API publica
# ===============================
# Copie este arquivo para .env e preencha com seus valores reais.
#   cp .env.example .env

# Chave de autenticacao usada no header: Authorization: ApiKey <DATAJUD_API_KEY>
# (gere/obtenha junto ao CNJ - https://datajud-wiki.cnj.jus.br/api-publica/)
DATAJUD_API_KEY=sua_chave_aqui

# Apelido do tribunal (usado na URL da API)
DATAJUD_TRIBUNAL_ALIAS=api_publica_tjsp

# URL base da API (endpoint de busca)
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br/api_publica_tjsp/_search